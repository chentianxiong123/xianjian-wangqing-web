owFace(2,duihua);\ndialogBox.setType(type_right);\ndialogBox.showNpcPortrait(2);\ndialogBox.setText(/月瑶/：紫萱姐，这就是你说的糖葫芦吗？);\ndialogBox.showDialog();\nscript.break();\nnpc.hideFace(2);\nnpc.setDirection(3,down);\nnpc.showFace(3,duihua);\ndialogBox.setType(type_right);\ndialogBox.showNpcPortrait(3);\ndialogBox.setText(/紫萱/：对呀，这的糖葫芦特别好吃。);\ndialogBox.showDialog();\nscript.break();\nnpc.hideFace(3);\nsystem.showAsideInfo(紫萱又想起长卿,1000);\nscript.wait(1000);\nscript.break();\ndialogBox.setType(type_right);\ndialogBox.showNpcPortrait(3);\ndialogBox.setText(/紫萱/：（尤其是和长卿一起吃糖葫芦的时候）);\ndialogBox.showDialog();\nscript.break();\nsystem.showAsideInfo(月瑶瞥了重楼一眼,1000);\nscript.wait(1000);\nscript.break();\nnpc.showFace(2,duihua);\ndialogBox.setType(type_right);\ndialogBox.showNpcPortrait(2);\ndialogBox.setText(/月瑶/：哇，好诱人啊。);\ndialogBox.showDialog();\nscript.break();\nnpc.hideFace(2);\nnpc.setDirection(2,right);\nnpc.setDirection(3,right);\nplayer.moveTo(710,130,false);\nscript.break();\nplayer.showFace(duihua);\ndialogBox.showPlayerPortrait();\ndialogBox.setType(type_left);\ndialogBox.setText(/重楼/：两串冰糖葫芦。);\ndialogBox.showDialog();\nscript.break();\nplayer.hideFace();\ndialogBox.hidePortrait();\nscript.break();\n\nnpc.showFace(20,duihua);\ndialogBox.setText(/货郎李/：好咧！);\ndialogBox.showDialog();\nscript.break();\nscript.wait(1000);\nscript.break();\ndialogBox.setText(/货郎李/：实在不好意思啊，就剩下最后一串。);\ndialogBox.showDialog();\nscript.break();\nnpc.hideFace(20);\nplayer.showFace(duihua);\ndialogBox.showPlayerPortrait();\ndialogBox.setType(type_left);\ndialogBox.setText(/重楼/：没有别的办法了么，她们两个人都想吃。);\ndialogBox.showDialog();\nscript.break();\nplayer.hideFace();\ndialogBox.hidePortrait();\nscript.break();\nnpc.showFace(20,duihua);\ndialogBox.setText(/货郎李/：大爷，我也是没办法啊，最近不知道为什么，物价上涨的太离谱了。);\ndialogBox.showDialog();\nscript.break();\nnpc.hideFace(20);\nnpc.showFace(3,duihua);\ndialogBox.setType(type_right);\ndialogBox.showNpcPortrait(3);\ndialogBox.setText(/紫萱/：重楼我们就帮帮他吧，看看是什么原因物价上涨了。);\ndialogBox.showDialog();\nscript.break();\ndialogBox.hidePortrait();\nnpc.hideFace(3);\nscript.break();\nnpc.showFace(20,duihua);\ndialogBox.setText(/货郎李/：那就多谢各位了，听说裁缝店的掌柜好像知道点消息，你们去看看吧。);\ndialogBox.showDialog();\nscript.break();\ndialogBox.setText(/货郎李/：不过现在只有这一串了，几位肯去帮我们苏州百姓解决物价上涨的问题，这串糖葫芦就送少侠了。);\ndialogBox.showDialog();\nscript.break();\ndialogBox.setText(/货郎李/：您拿好！);\ndialogBox.showDialog();\nscript.break();\nnpc.hideFace(20);\nsystem.showAsideInfo(解决物价上涨,1500);\nscript.wait(1500);\nplayer.task(物价上涨);\ngame.markEvent(1980);\nplayer.moveTo(680,130,false);\nscript.break();\ngame.branch(给月瑶,xuanze.str,8,给紫萱,xuanze.str,9);\nscript.closeScriptList();"},{"x":516,"y":321,"w":14,"h":32,"script":"script.openScriptList()[!eventMarked(11111)];\ngame.markEvent(11111);\ngame.branch(前往苏州城东,xuanze.str,36,不想去,xuanze.str,37);\nscript.closeScriptList();"},{"x":432,"y":224,"w":49,"h":6,"script":"player.moveTo(-1,player.y-20,false);\r\nworld.change(sn_yg1.map,sn.bin,shinei.ant,shinei.bin,176,360,up);"}],"triggers":[{"x":2,"y":506,"w":120,"h":38,"script":null},{"x":122,"y":525,"w":141,"h":19,"script":null},{"x":263,"y":507,"w":146,"h":37,"script":null},{"x":409,"y":524,"w":138,"h":20,"script":null},{"x":547,"y":511,"w":126,"h":33,"script":null},{"x":673,"y":528,"w":127,"h":16,"script":null},{"x":794,"y":282,"w":6,"h":246,"script":null},{"x":0,"y":448,"w":112,"h":8,"script":null},{"x":104,"y":456,"w":8,"h":15,"script":null},{"x":112,"y":464,"w":152,"h":7,"script":null},{"x":256,"y":448,"w":8,"h":16,"script":null},{"x":264,"y":448,"w":152,"h":7,"script":null},{"x":409,"y":455,"w":7,"h":16,"script":null},{"x":416,"y":464,"w":145,"h":7,"script":null},{"x":533,"y":438,"w":6,"h":26,"script":null},{"x":533,"y":433,"w":171,"h":5,"script":null},{"x":768,"y":432,"w":26,"h":5,"script":null},{"x":768,"y":352,"w":26,"h":13,"script":null},{"x":513,"y":353,"w":191,"h":14,"script":null},{"x":517,"y":322,"w":7,"h":31,"script":null},{"x":345,"y":307,"w":199,"h":15,"script":null},{"x":192,"y":322,"w":160,"h":15,"script"